# =============================================================================
# OpenNoter 环境变量示例
# Docker 部署：cp .env.example .env，按需修改，然后 docker compose up --build -d
#
# 注意区分两类变量：
#   1) VITE_* 是【构建时】变量，会被烘进前端 JS bundle。改完必须重新构建 frontend
#      镜像才会生效，只 restart 不行。
#   2) 其他后端变量是【运行时】变量，改完 docker compose up -d 即可。
#
# 提醒：LLM API key 不要写在这里！请部署完成后，从前端「模型供应商」页面录入，
#       这些 key 会保存到 SQLite 数据库（默认 ./backend/data/open_noter.db）并随容器持久化。
# =============================================================================

# 通用端口配置
BACKEND_PORT=8483 # 后端端口
FRONTEND_PORT=3015
BACKEND_HOST=0.0.0.0 # 默认为 0.0.0.0，表示监听所有 IP 地址 不建议动
APP_PORT=3015 # docker 部署时对外暴露端口（浏览器访问的端口）

# 前端访问后端用（开发环境直连；Docker 部署下走 nginx 代理，此值仅作回退）
VITE_API_BASE_URL=http://127.0.0.1:8483
VITE_SCREENSHOT_BASE_URL=http://127.0.0.1:8483/static/screenshots
VITE_FRONTEND_PORT=3015

# 生产环境配置
ENV=production
STATIC=/static
OUT_DIR=./static/screenshots
NOTE_OUTPUT_DIR=note_results
IMAGE_BASE_URL=/static/screenshots
DATA_DIR=data

# 对外可访问的站点地址（不要带 /api 后缀）。
# API 使用指引（GET /api/）会把它作为 api_root 返回给调用方，方便 agent 直接拼 URL。
# 线上是 client → SafeLine(443) → NPMplus(80) → backend，NPMplus 会用 $scheme 覆盖
# X-Forwarded-Proto（它自己收到的是 http），后端从请求头推不出正确的 https，
# 所以这里显式声明。自建直连（无反代）时可以不填。
# OPENNOTER_PUBLIC_BASE_URL=https://opennoter.example.com

# FFMPEG 配置（Docker 镜像已内置 ffmpeg，留空即可；自建/桌面端可填绝对路径）
FFMPEG_BIN_PATH=

# 转写器配置
# TRANSCRIBER_TYPE 可选：fast-whisper / bcut / kuaishou / mlx-whisper(仅 Apple Silicon) / groq
TRANSCRIBER_TYPE=fast-whisper
# WHISPER_MODEL_SIZE 默认 tiny (~75MB)，首次启动快；想要更高识别质量可在前端
# 「音频转写配置」页切到 base/small/medium/large。直接在这里改大尺寸会触发
# 首次启动下载 ~1.5GB 文件，慢网络或 4GB 内存的容器容易 OOM。
WHISPER_MODEL_SIZE=tiny

GROQ_TRANSCRIBER_MODEL=whisper-large-v3-turbo # groq提供的faster-whisper 默认为 whisper-large-v3-turbo

# 图片代理（/api/image_proxy）的来源域名白名单，逗号分隔，不带协议。
# 留空 = 用内置的各平台图片 CDN 列表（hdslb.com / ytimg.com / douyinpic.com 等）；
# 填 * = 不限制域名（仍会拦截内网地址）；
# 填自定义列表 = 只允许这些域名，用来兜住「图片实际来自别处」的情况。
# OPENNOTER_IMAGE_PROXY_ALLOWED_HOSTS=

# whisper 本地模型从 HuggingFace 下载。镜像默认 HF_ENDPOINT=https://hf-mirror.com（国内友好）。
# 若下载失败（容器连不上镜像站），可在此覆盖为官方源或其它镜像，例如：
#   HF_ENDPOINT=https://huggingface.co
# 注意：宿主机的 VPN/代理默认不会进入容器。若要让模型下载走代理，请在前端「设置」里
# 配置代理（会自动应用到 HuggingFace 下载），或在下面用标准环境变量指定：
#   HTTP_PROXY=http://host.docker.internal:7890
#   HTTPS_PROXY=http://host.docker.internal:7890
# HF_ENDPOINT=https://hf-mirror.com

# =============================================================================
# 下载限制（app/downloaders/limits.py）
#
# 下载器在真正拉流之前会先判一次上限，超限直接失败并给出可读消息，
# 而不是「先下完 3 小时 4K 再发现磁盘满了」。
# 0 表示不限制。
# =============================================================================

# 单个媒体文件的大小上限（MB）。超限直接失败并给出可读消息（不会自动降画质重试）。
# 默认 200，与 astrbot_plugin_link_resolver 的默认值对齐。
DOWNLOAD_MAX_SIZE_MB=200

# 视频时长上限（秒）。超限直接拒绝，连元信息都不再拉。
# 笔记任务是"看完再整理"，长视频的投入产出比很差。默认 300。
DOWNLOAD_MAX_DURATION_SECONDS=300

# 任务级重试次数（不含首次尝试）。只重试网络类异常；
# SizeLimitExceeded / DurationLimitExceeded 这类确定性失败不重试。默认 2。
DOWNLOAD_RETRY_COUNT=2

# =============================================================================
# Cookie 格式说明（app/services/cookie_policy.py）
#
# 各平台下载器需要的 Cookie 格式不同，填错会导致「同步成功但没有生效」：
#   - B 站 / 抖音 / 快手：`name=value; name=value` 请求头形式
#       B 站最小可用：SESSDATA + bili_jct（扫码登录会自动写入）
#       抖音无需登录 Cookie，下载器会自己引导匿名 ttwid；
#       但如果你有登录态，浏览器一键同步也会保留 UIFID_TEMP 等风控相关项。
#   - YouTube：**Netscape cookies.txt**（7 个 tab 分隔字段的文件内容）
#       不能用 name=value 形式。浏览器插件「一键同步」对 YouTube 不生效
#       （扩展侧 allowlist 为空），需要手动粘贴 cookies.txt。
#       YouTube 的 Cookie 用于：年龄限制视频、会员内容、以及 403 风控。
# =============================================================================

# =============================================================================
# 鉴权（app/services/auth.py）
#
# **默认已强制认证**（AUTH_ENFORCE 默认 true）。未带 JWT Cookie / Bearer /
# x-api-key 的业务接口一律 401，匿名无法创建任务。
#
# 仅以下场景才考虑显式关闭：单机自托管、只在内网用、不想配账号。
# 关闭后匿名可创建任务（user_id 为空），且会启用 ANON_* 全局限流；
# **绝对不要**在公网上这样配置。
# JWT 签名密钥：可用 OPENNOTER_JWT_SECRET 或 OPENNOTER_SECRET_KEY（二者至少设一个）。
# 同一密钥经 HKDF 派生后，还用于静态加密：
#   - 平台 Cookie（config/downloader.json，app/utils/secret_box.py）
#   - LLM Provider api_key（providers 表；启动时明文 → enc:v1: 自动迁移）
# 生产务必换成长随机串；更换密钥会使旧密文无法解密，需重新填写 Cookie / api_key。
# =============================================================================
# 默认即 true，一般无需显式设置。仅内网单人自托管想关闭时才填 false。
# OPENNOTER_AUTH_ENFORCE=true
# OPENNOTER_JWT_SECRET=please-change-me-to-a-long-random-string
# OPENNOTER_SECRET_KEY=please-change-me-to-a-long-random-string

# JWT 有效期（小时）。默认 168（7 天）。
# OPENNOTER_JWT_TTL_HOURS=168

# 登录 Cookie 是否带 Secure 标记。默认 true。
# **纯 HTTP（非 localhost）部署时必须设为 false**，否则浏览器会丢弃 Cookie、
# 表现为「登录成功但立刻又回到登录页」。
# OPENNOTER_COOKIE_SECURE=false

# 首个账号怎么来：本项目**没有注册接口**，全新部署时用户表为空，
# 必须先跑 CLI 建号，否则登录页无法通过：
#   compose:    docker exec -it opennoter-backend python manage.py create-user you@example.com --admin
#   源码运行:   cd backend && python manage.py create-user you@example.com --admin
# 也可以先设下面两个变量再跑 `python migrate_users.py`（幂等，只在没有管理员时生效）：
# ADMIN_EMAIL=admin@opennoter.local
# ADMIN_PASSWORD=<长随机串>

# =============================================================================
# OIDC 单点登录（可选，app/services/oidc.py）
# 三个都填才会启用；留空则登录页不显示 SSO 按钮。
# 首个通过 OIDC 登录的用户会自动成为管理员。
# =============================================================================
# OIDC_ISSUER=https://your-idp.example.com/application/o/opennoter/
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=https://your-host/api/auth/oidc/callback
# POST_LOGIN_REDIRECT=/

# =============================================================================
# 本地上传（app/utils/upload_paths.py）
# 单文件大小上限（MB）。0 = 不限制。默认 500。
# nginx client_max_body_size 已对齐为 512m（见 nginx/*.conf）；若上调本值，
# 请同步增大 nginx 限额，否则大文件会在入口被 413 截断。
# DOWNLOAD_MAX_SIZE_MB 限制的是出站下载体积，不是请求体。
# =============================================================================
UPLOAD_MAX_SIZE_MB=500
UPLOAD_DIR=uploads

# =============================================================================
# 供应商探活 SSRF（POST /api/probe_endpoint）
# 默认复用 assert_safe_url：拦截私网 / 环回 / 云元数据地址。
# 本机 Ollama 等私网端点探活时再打开：
# OPENNOTER_PROBE_ALLOW_PRIVATE=true
# =============================================================================

# =============================================================================
# CORS 扩展源（backend/app/utils/cors_origins.py）
#
# 生产：填商店/固定扩展 ID（逗号分隔），勿打开「任意扩展」。
# 开发 unpacked：ID 每次加载可能变，可临时 OPENNOTER_CORS_ALLOW_ANY_EXTENSION=true。
# 公网部署请保持默认（false）+ 显式白名单。
# =============================================================================
# OPENNOTER_CORS_EXTENSION_IDS=abcdefghijklmnopqrstuvwxyzabcdef
# OPENNOTER_CORS_ALLOW_ANY_EXTENSION=false

# =============================================================================
# 用户/匿名配额（app/services/quota.py）
# 登录用户：USER_*；匿名（AUTH_ENFORCE=false 时）：ANON_* 全局限流。
# 0 = 该维度不限制。公网请优先 OPENNOTER_AUTH_ENFORCE=true。
# =============================================================================
# OPENNOTER_USER_MAX_CONCURRENT_TASKS=2
# OPENNOTER_USER_DAILY_TASK_LIMIT=50
# OPENNOTER_USER_STORAGE_QUOTA_MB=2048
# OPENNOTER_ANON_MAX_CONCURRENT_TASKS=2
# OPENNOTER_ANON_SUBMIT_RPM=10

# =============================================================================
# 数据库（默认 SQLite 单机；多副本必须改 Postgres 等，见 README「多副本」）
# compose 默认把库挂在 ./backend/data → /app/data
# =============================================================================
# DATABASE_URL=sqlite:////app/data/open_noter.db
# DATABASE_URL=postgresql+psycopg2://user:pass@db:5432/opennoter

